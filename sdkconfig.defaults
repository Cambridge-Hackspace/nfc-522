# Rust often needs a bit of an extra main task stack size compared to C (the default is 3K)
# Bumped for TLS handshakes + JSON serialization which are stack-heavy.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=16384

# Bundled CA certificate store, used for MQTT over TLS (mqtts).
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_DEFAULT_FULL=y

# Increase a bit these stack sizes as they are also a bit too small by default
CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=4096
CONFIG_FREERTOS_IDLE_TASK_STACKSIZE=4096

# You might have to increase this further if you spawn your own Rust threads 
# that allocate large stack variables; or better yet - use 
# `std::thread::Builder::new().stack_size(XXX)` for spawning
CONFIG_PTHREAD_TASK_STACK_SIZE_DEFAULT=4096

# If the watchdog timer times out the time can be adjusted here
#CONFIG_ESP_TASK_WDT=y
#CONFIG_ESP_TASK_WDT_TIMEOUT_S=5      # Timeout in seconds
#CONFIG_ESP_TASK_WDT_PANIC=y           # Panic/reset on timeout

# Route the primary console (stdio, and therefore the provisioning serial
# protocol in src/provisioning/serial.rs) over the native USB-Serial-JTAG
# peripheral instead of UART0. This board is programmed and used entirely
# over that USB connector — UART0's RX/TX pins aren't wired to anything
# reachable here, so leaving USB-Serial-JTAG as merely a secondary,
# output-only console (the esp-idf default) meant stdin never received any
# bytes. Confirmed on real hardware: without this, log lines occasionally
# echoed through as the secondary console, but nothing written to the port
# ever reached `std::io::stdin()`.
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y